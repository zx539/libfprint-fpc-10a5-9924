{
  "name": "fedora-fingerprint-manager",
  "version": "0.1.0",
  "private": true,
  "author": "Fedora Fingerprint Manager contributors",
  "homepage": "https://github.com/Terrydaktal/libfprint-fpc-10a5-9924",
  "description": "GNOME-style Fedora fingerprint manager for fprintd/libfprint",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "preview": "vite preview",
    "dist:rpm": "bash scripts/build-rpm.sh",
    "dist:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron-builder": "^24.13.3",
    "electron": "^30.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.terrydaktal.FingerprintManager",
    "productName": "Fedora Fingerprint Manager",
    "executableName": "fedora-fingerprint-manager",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "linux": {
      "target": [{ "target": "rpm", "arch": ["x64"] }],
      "artifactName": "fedora-fingerprint-manager-${version}-${arch}.${ext}",
      "category": "System;Settings;Security;",
      "synopsis": "Manage fprintd fingerprints on Fedora",
      "description": "GNOME-style fingerprint manager for Fedora using fprintd and libfprint.",
      "maintainer": "Fedora Fingerprint Manager"
    },
    "rpm": { "depends": ["fprintd", "polkit", "usbutils"] }
  }
}
